{
  "_comment": "Team-shared Claude Code project settings. Committed to version control. See https://code.claude.com/docs/en/settings.md for the full schema. Personal overrides belong in settings.local.json (gitignored).",

  "permissions": {
    "allow": [
      "Bash(pytest tests/*)",
      "Bash(python -m pytest tests/*)",
      "Bash(python -m pytest *)",
      "Bash(pip install:*)",
      "Bash(pip show:*)",
      "Bash(python -c *)",
      "Bash(python -m *)",
      "Bash(mkdir -p *)",
      "Bash(ls *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  }
}
